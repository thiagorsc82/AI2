# Modo: "serpapi" (dados reais do Google Flights) ou "demo" (dados sintéticos)
PROVIDER=demo
SERPAPI_KEY=
ORIGIN=BEL
CURRENCY=BRL
# Datas monitoradas: dias à frente a partir de hoje (ex.: 30,60,90)
DAYS_AHEAD=60
# Ida e volta? Se >0, volta = ida + N dias. 0 = somente ida (metade das chamadas)
TRIP_LENGTH_DAYS=0
# Destinos ativos (códigos IATA). Cada destino x data = 1 chamada por hora.
DESTINATIONS=LIS,OPO,MAD,BCN,CDG,FCO
CHECK_INTERVAL_MINUTES=60
